/* =========================
   MENU
========================= */

function renderMenu(){

let search =
document.getElementById(
"menuSearch"
).value
.toLowerCase();

let cat =
document.getElementById(
"menuCategory"
).value;

let result =
products.filter(p => {

let matchName =
p.name
.toLowerCase()
.includes(search);

let matchCat =
cat === "all" ||
p.category === cat;

return matchName && matchCat;

});


document.getElementById(
"menuProducts"
).innerHTML =
result
.map(productHTML)
.join("");

}


/* =========================
   NAVIGASI
========================= */

function go(page){

document
.querySelectorAll(".page")
.forEach(p =>
p.classList.remove("active")
);

document
.getElementById(
"page-"+page
)
.classList.add("active");


document
.querySelectorAll(".nav-btn")
.forEach(btn => {

btn.classList.remove("active");

if(
btn.dataset.page === page
){
btn.classList.add("active");
}

});


if(page === "menu"){
renderMenu();
}

if(page === "cart"){
renderCart();
}

window.scrollTo(0,0);

}


/* =========================
   FILTER
========================= */

function category(cat){

document.getElementById(
"menuCategory"
).value = cat;

document.getElementById(
"menuSearch"
).value = "";

go("menu");

}


/* =========================
   SEARCH
========================= */

function searchGlobal(value){

go("menu");

document.getElementById(
"menuSearch"
).value = value;

renderMenu();

}


/* =========================
   ADD CART
========================= */

function addCart(id){

let p =
products.find(
x => x.id === id
);

let existing =
cart.find(
x => x.id === id
);

if(existing){

existing.qty++;

}else{

cart.push({

id:p.id,
name:p.name,
price:p.price,
image:p.image,
qty:1

});

}

saveCart();

updateCount();

showToast(
"☕ "+p.name+
" masuk keranjang"
);

}


/* =========================
   SAVE
========================= */

function saveCart(){

localStorage.setItem(
"kopiOciokCart",
JSON.stringify(cart)
);

}


/* =========================
   COUNT
========================= */

function updateCount(){

let total =
cart.reduce(
(a,b)=>a+b.qty,
0
);

document.getElementById(
"cartCount"
).textContent =
total;

document.getElementById(
"summaryQty"
).textContent =
total;

}


/* =========================
   CART
========================= */

function renderCart(){

let box =
document.getElementById(
"cartItems"
);

if(cart.length === 0){

box.innerHTML = `

<div class="empty">

<div class="empty-icon">
🛒
</div>

<h3>
Keranjang kosong
</h3>

<p>
Yuk pilih menu favoritmu.
</p>

<button
class="hero-btn"
onclick="go('menu')">

Belanja Sekarang

</button>

</div>

`;

}else{

box.innerHTML =
cart.map(item => `

<div class="cart-item">

<img
class="cart-img"
src="${item.image}">

<div class="cart-info">

<h3>
${item.name}
</h3>

<div class="cart-price">
${rupiah(item.price)}
</div>

<div class="qty">

<button
onclick="changeQty(${item.id},-1)">
−
</button>

<strong>
${item.qty}
</strong>

<button
onclick="changeQty(${item.id},1)">
+
</button>

<button
class="remove"
onclick="removeCart(${item.id})">

Hapus

</button>

</div>

</div>

</div>

`).join("");

}


let total =
cart.reduce(
(a,b)=>
a+b.price*b.qty,
0
);


document.getElementById(
"summarySubtotal"
).textContent =
rupiah(total);

document.getElementById(
"summaryTotal"
).textContent =
rupiah(total);

updateCount();

}


/* =========================
   JUMLAH
========================= */

function changeQty(id,value){

let item =
cart.find(
x=>x.id===id
);

if(!item)return;

item.qty += value;

if(item.qty<=0){

cart =
cart.filter(
x=>x.id!==id
);

}

saveCart();

renderCart();

}


/* =========================
   HAPUS
========================= */

function removeCart(id){

cart =
cart.filter(
x=>x.id!==id
);

saveCart();

renderCart();

showToast(
"Produk dihapus"
);

}


/* =========================
   FAVORITE
========================= */

function favorite(btn){

if(
btn.textContent.trim()
==="♡"
){

btn.textContent="♥";

btn.style.color=
"#ff4444";

showToast(
"❤️ Ditambahkan ke favorit"
);

}else{

btn.textContent="♡";

btn.style.color=
"white";

}

}


/* =========================
   WHATSAPP
========================= */

function checkout(){

if(cart.length===0){

showToast(
"🛒 Keranjang masih kosong"
);

return;

}

let pesan =
"Halo KOPI OCIOK 👋%0A%0A"+
"Saya ingin memesan:%0A";

cart.forEach(item=>{

pesan +=
"• "+item.name+
" x"+item.qty+
" = "+
rupiah(
item.price*item.qty
)+
"%0A";

});


let total =
cart.reduce(
(a,b)=>
a+b.price*b.qty,
0
);

pesan +=
"%0A💰 Total: "+
rupiah(total)+
"%0A%0A";

pesan +=
"Terima kasih ☕";


/*
=================================
GANTI NOMOR WHATSAPP DI SINI
=================================
*/

let nomor =
"6280000000000";


window.open(
"https://wa.me/"+
nomor+
"?text="+
pesan,
"_blank"
);

}


/* =========================
   TOAST
========================= */

let toastTimer;

function showToast(text){

let toast =
document.getElementById(
"toast"
);

toast.textContent=text;

toast.classList.add("show");

clearTimeout(toastTimer);

toastTimer =
setTimeout(
()=>{
toast.classList.remove(
"show"
);
},
2000
);

}


/* =========================
   START
========================= */

window.addEventListener(
"load",
()=>{

renderHome();

updateCount();

setTimeout(
()=>{

document
.querySelector(".loader")
?.remove();

},
1200
);

});

