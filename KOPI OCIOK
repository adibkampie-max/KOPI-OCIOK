<!DOCTYPE html>
<html lang="id">
<!-- SUPABASE -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,
      initial-scale=1.0,
      maximum-scale=1.0,
      user-scalable=no">

<title>KOPI OCIOK</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    -webkit-tap-highlight-color:transparent;
}

html{
    scroll-behavior:smooth;
}

body{
    width:100%;
    min-height:100vh;
    background:#0b0b0d;
    color:#fff;
    font-family:Arial,sans-serif;
    overflow-x:hidden;
    padding-bottom:78px;
}

/* =========================
   WARNA
========================= */

:root{
    --bg:#0b0b0d;
    --card:#17171b;
    --card2:#202025;
    --orange:#ff6b00;
    --orange2:#ff8c32;
    --text:#fff;
    --muted:#999;
    --line:#29292f;
}

/* =========================
   PROMO BERJALAN
========================= */

.running{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:34px;
    z-index:5000;
    background:linear-gradient(
        90deg,
        #ff4b00,
        #ff7600,
        #ff4b00
    );
    overflow:hidden;
    display:flex;
    align-items:center;
}

.running-text{
    white-space:nowrap;
    font-size:12px;
    font-weight:bold;
    animation:jalan 18s linear infinite;
}

@keyframes jalan{
    from{
        transform:translateX(100%);
    }
    to{
        transform:translateX(-100%);
    }
}

/* =========================
   HEADER MOBILE
========================= */

header{
    position:fixed;
    top:34px;
    left:0;
    width:100%;
    height:62px;
    z-index:4000;
    background:rgba(11,11,13,.96);
    backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line);
}

.header{
    height:100%;
    padding:0 13px;
    display:flex;
    align-items:center;
    gap:10px;
}

.logo{
    min-width:max-content;
    font-size:17px;
    font-weight:900;
}

.logo span{
    color:var(--orange);
}

.search{
    flex:1;
    position:relative;
}

.search input{
    width:100%;
    height:39px;
    background:#202025;
    border:1px solid #303038;
    border-radius:20px;
    outline:none;
    color:white;
    padding:0 13px 0 37px;
    font-size:12px;
}

.search-icon{
    position:absolute;
    left:13px;
    top:11px;
    font-size:14px;
}

.cart-head{
    width:39px;
    height:39px;
    border:0;
    border-radius:50%;
    background:#202025;
    color:white;
    position:relative;
    font-size:18px;
}

.cart-count{
    position:absolute;
    top:-4px;
    right:-3px;
    background:#ff3131;
    width:17px;
    height:17px;
    border-radius:50%;
    font-size:9px;
    display:flex;
    align-items:center;
    justify-content:center;
}

/* =========================
   HALAMAN
========================= */

.page{
    display:none;
    padding-top:108px;
    min-height:100vh;
    animation:page .3s ease;
}

.page.active{
    display:block;
}

@keyframes page{
    from{
        opacity:0;
        transform:translateY(10px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.container{
    width:100%;
    padding:14px;
}

/* =========================
   HERO
========================= */

.hero{
    height:310px;
    border-radius:18px;
    overflow:hidden;
    position:relative;

    background:
    linear-gradient(
        90deg,
        rgba(0,0,0,.92),
        rgba(0,0,0,.45)
    ),
    url(
    "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=900&q=80"
    )
    center/cover;
}

.hero-content{
    position:absolute;
    left:20px;
    right:20px;
    top:40px;
}

.hero-small{
    color:var(--orange2);
    font-size:11px;
    font-weight:bold;
    margin-bottom:12px;
}

.hero h1{
    font-size:38px;
    line-height:1.05;
    margin-bottom:14px;
}

.hero h1 span{
    color:var(--orange);
}

.hero p{
    color:#ccc;
    font-size:12px;
    line-height:1.6;
    max-width:280px;
}

.hero-btn{
    margin-top:18px;
    background:var(--orange);
    color:white;
    border:0;
    border-radius:10px;
    padding:13px 18px;
    font-size:12px;
    font-weight:bold;
}

.hero-btn:active{
    transform:scale(.95);
}

.floating-coffee{
    position:absolute;
    right:20px;
    bottom:25px;
    font-size:65px;
    animation:float 2.7s infinite ease-in-out;
}

@keyframes float{
    0%,100%{
        transform:translateY(0) rotate(-4deg);
    }
    50%{
        transform:translateY(-15px) rotate(5deg);
    }
}

/* =========================
   JUDUL
========================= */

.title{
    margin:25px 0 13px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.title h2{
    font-size:19px;
}

.title span{
    color:var(--orange);
    font-size:11px;
}

/* =========================
   KATEGORI
========================= */

.categories{
    display:grid;
    grid-template-columns:
        repeat(4,1fr);
    gap:8px;
}

.category{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:12px;
    padding:12px 4px;
    text-align:center;
    transition:.2s;
}

.category:active{
    transform:scale(.94);
}

.category-icon{
    width:43px;
    height:43px;
    margin:auto;
    border-radius:50%;
    background:#27272c;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:21px;
    margin-bottom:7px;
}

.category h3{
    font-size:9px;
}

.category p{
    font-size:8px;
    color:var(--muted);
    margin-top:3px;
}

/* =========================
   PRODUK
========================= */

.products{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
}

.product{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:13px;
    overflow:hidden;
    animation:produk .5s ease;
}

@keyframes produk{
    from{
        opacity:0;
        transform:translateY(15px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.product-img{
    width:100%;
    height:155px;
    position:relative;
    overflow:hidden;
}

.product-img img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.4s;
}

.product:active
.product-img img{
    transform:scale(1.05);
}

.badge{
    position:absolute;
    top:8px;
    left:8px;
    background:var(--orange);
    border-radius:5px;
    padding:5px 7px;
    font-size:8px;
    font-weight:bold;
}

.favorite{
    position:absolute;
    top:8px;
    right:8px;
    width:29px;
    height:29px;
    border:0;
    border-radius:50%;
    background:rgba(0,0,0,.65);
    color:white;
    font-size:16px;
}

.product-info{
    padding:10px;
}

.product-category{
    color:var(--orange2);
    font-size:8px;
    margin-bottom:4px;
}

.product-name{
    font-size:13px;
    font-weight:bold;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.product-desc{
    color:var(--muted);
    font-size:9px;
    line-height:1.4;
    margin-top:5px;
    height:25px;
    overflow:hidden;
}

.product-bottom{
    margin-top:9px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.price{
    color:var(--orange2);
    font-size:12px;
    font-weight:900;
}

.add{
    width:32px;
    height:32px;
    border:0;
    border-radius:8px;
    background:var(--orange);
    color:white;
    font-size:20px;
    line-height:30px;
}

.add:active{
    transform:scale(.88);
}

/* =========================
   SEARCH MENU
========================= */

.menu-tools{
    display:flex;
    gap:8px;
    margin-bottom:15px;
}

.menu-search{
    flex:1;
}

.menu-search input,
.menu-select{
    width:100%;
    height:42px;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:9px;
    color:white;
    outline:none;
    padding:0 11px;
    font-size:11px;
}

.menu-select{
    width:125px;
}

/* =========================
   PROMO
========================= */

.promo{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.promo-card{
    min-height:165px;
    border-radius:15px;
    padding:22px;
    position:relative;
    overflow:hidden;
    background:
        linear-gradient(
            120deg,
            #27160d,
            #17171b
        );
    border:1px solid #3b2516;
}

.promo-card h2{
    color:var(--orange2);
    font-size:20px;
}

.promo-card p{
    color:#aaa;
    font-size:11px;
    line-height:1.6;
    max-width:230px;
    margin-top:8px;
}

.promo-code{
    display:inline-block;
    margin-top:15px;
    padding:8px 12px;
    border:1px dashed var(--orange);
    border-radius:6px;
    color:#ffc15a;
    font-size:10px;
    font-weight:bold;
}

.promo-emoji{
    position:absolute;
    right:15px;
    bottom:5px;
    font-size:70px;
    animation:float 3s infinite ease-in-out;
}

/* =========================
   KERANJANG
========================= */

.cart-box{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:14px;
    padding:12px;
}

.cart-item{
    display:flex;
    gap:10px;
    padding:12px 0;
    border-bottom:1px solid var(--line);
}

.cart-item:last-child{
    border-bottom:0;
}

.cart-img{
    width:72px;
    height:72px;
    object-fit:cover;
    border-radius:9px;
}

.cart-info{
    flex:1;
}

.cart-info h3{
    font-size:13px;
}

.cart-price{
    color:var(--orange2);
    font-size:11px;
    margin-top:5px;
}

.qty{
    display:flex;
    align-items:center;
    gap:7px;
    margin-top:8px;
}

.qty button{
    width:26px;
    height:26px;
    border:0;
    background:#303036;
    color:white;
    border-radius:6px;
}

.qty button:active{
    background:var(--orange);
}

.remove{
    border:0;
    background:none;
    color:#ff5555;
    font-size:9px;
    margin-left:5px;
}

.summary{
    margin-top:12px;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:14px;
    padding:17px;
}

.summary h2{
    font-size:17px;
    margin-bottom:17px;
}

.summary-row{
    display:flex;
    justify-content:space-between;
    margin:10px 0;
    color:#aaa;
    font-size:12px;
}

.summary-total{
    border-top:1px solid var(--line);
    padding-top:14px;
    display:flex;
    justify-content:space-between;
    font-size:17px;
    font-weight:bold;
}

.summary-total span:last-child{
    color:var(--orange2);
}

.checkout{
    width:100%;
    margin-top:15px;
    height:48px;
    border:0;
    border-radius:10px;
    background:var(--orange);
    color:white;
    font-weight:bold;
    font-size:12px;
}

.checkout:active{
    transform:scale(.97);
}

/* =========================
   AKUN
========================= */

.account{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:15px;
    padding:25px 15px;
    text-align:center;
}

.avatar{
    width:75px;
    height:75px;
    border-radius:50%;
    background:linear-gradient(
        135deg,
        #ff6b00,
        #ffb347
    );
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:35px;
    margin:auto auto 12px;
}

.account h2{
    font-size:19px;
}

.account p{
    color:#888;
    font-size:11px;
    margin-top:5px;
}

.account-menu{
    display:flex;
    flex-direction:column;
    gap:8px;
    margin-top:20px;
}

.account-menu div{
    text-align:left;
    background:#222227;
    padding:15px;
    border-radius:9px;
    font-size:12px;
}

.account-menu div:active{
    background:#2b2b30;
}

/* =========================
   KOSONG
========================= */

.empty{
    text-align:center;
    padding:60px 15px;
    color:#888;
}

.empty-icon{
    font-size:55px;
    margin-bottom:12px;
}

/* =========================
   BOTTOM NAV
========================= */

.bottom{
    position:fixed;
    bottom:0;
    left:0;
    width:100%;
    height:70px;
    z-index:4000;
    background:rgba(20,20,23,.97);
    backdrop-filter:blur(15px);
    border-top:1px solid var(--line);
}

.bottom-menu{
    width:100%;
    height:100%;
    display:grid;
    grid-template-columns:repeat(5,1fr);
}

.nav-btn{
    border:0;
    background:none;
    color:#777;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:3px;
    font-size:9px;
}

.nav-btn span{
    font-size:21px;
}

.nav-btn.active{
    color:var(--orange);
}

.nav-btn:active{
    transform:scale(.9);
}

/* =========================
   TOAST
========================= */

.toast{
    position:fixed;
    bottom:88px;
    left:50%;
    transform:translate(-50%,20px);
    background:#29292e;
    padding:11px 17px;
    border-radius:9px;
    font-size:11px;
    opacity:0;
    pointer-events:none;
    z-index:8000;
    transition:.3s;
    white-space:nowrap;
}

.toast.show{
    opacity:1;
    transform:translate(-50%,0);
}

/* =========================
   LOADING
========================= */

.loader{
    position:fixed;
    inset:0;
    background:#0b0b0d;
    z-index:9999;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
}

.loader-logo{
    font-size:25px;
    font-weight:900;
}

.loader-logo span{
    color:var(--orange);
}

.loader-coffee{
    font-size:55px;
    margin:15px;
    animation:float 1.3s infinite ease-in-out;
}

.loader-line{
    width:160px;
    height:4px;
    background:#242428;
    border-radius:10px;
    overflow:hidden;
}

.loader-progress{
    height:100%;
    width:0;
    background:var(--orange);
    animation:load 1.5s forwards;
}

@keyframes load{
    to{
        width:100%;
    }
}

/* =========================
   KHUSUS HP
========================= */

@media(min-width:700px){

    body{
        width:390px;
        min-height:100vh;
        margin:auto;
        box-shadow:
            0 0 50px rgba(0,0,0,.7);
    }

    header,
    .running,
    .bottom{
        width:390px;
        left:50%;
        transform:translateX(-50%);
    }

    .toast{
        left:50%;
    }

}

</style>
</head>

